# URL de base du backend Nexolia (Express).
# Le backend doit autoriser cette origine dans sa configuration CORS.
NEXT_PUBLIC_API_URL=http://localhost:3320

# Serveur Socket.IO, pour les notifications en temps réel.
# Le serveur Socket.IO est monté sur le même processus et le même port que l'API
# Express, mais il a sa propre URL : par défaut le client viserait le port 3000
# de Next.js, où aucun serveur Socket.IO n'écoute.
NEXT_PUBLIC_SOCKET_URL=http://localhost:3320
